# Copy to .env and fill in. Never commit .env.
BASE_DOMAIN=yourdomain.com        # tenants live at <slug>.yourdomain.com
DEFAULT_TENANT=demo               # used for bare hosts like localhost
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=1                   # 1 behind HTTPS (Caddy); 0 for local http
ACME_EMAIL=you@example.com        # Caddy / Let's Encrypt contact

# Any OpenAI-compatible endpoint (Groq, OpenRouter, Together, local vLLM/Ollama, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

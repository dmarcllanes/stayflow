# Wildcard tenant routing: <slug>.{$BASE_DOMAIN} -> app.
# Uses on-demand TLS (per-subdomain Let's Encrypt certs) so stock Caddy works without a
# DNS-provider plugin. The app's /_tls_check only approves hostnames that are real tenants.
# DNS: point both  {$BASE_DOMAIN}  and  *.{$BASE_DOMAIN}  A records at the EC2 Elastic IP.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/_tls_check
	}
}

*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$BASE_DOMAIN} {
	respond "StayFlow" 200
}
